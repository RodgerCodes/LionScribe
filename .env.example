# LionScribe Environment Configuration

# Flask Secret Key
SECRET_KEY=dev-secret-key-change-in-production

# Whisper Model ('tiny', 'base', 'small')
# 'base' is recommended: lightweight, fast, and half-decent accuracy
WHISPER_MODEL=base

# Llama 3 Configuration
# Options:
# 1. Ollama (default local endpoint): http://localhost:11434/api
LLAMA_MODEL=llama3:8b
LLAMA_API_BASE=http://localhost:11434/api

# 2. Groq Cloud (ultra-fast Llama 3 inference, optional):
# GROQ_API_KEY=gsk_...

# 3. Custom OpenAI-compatible Llama 3 Endpoint (optional):
# LLAMA_API_KEY=your-api-key
# LLAMA_API_BASE=https://api.together.xyz/v1
